# MongoDB Atlas (or local)
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/vericlaim?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional: Python AI microservice (see /ai-service)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_IMAGE_DETECT_URL=http://127.0.0.1:8000/detect-image
AI_TEXT_DETECT_URL=http://127.0.0.1:8000/detect-text

# Heuristic threshold 0–1; higher = stricter fake detection
AI_FAKE_THRESHOLD=0.65
AI_IMAGE_AUTH_THRESHOLD=0.55
AI_TEXT_AUTH_THRESHOLD=0.60

# Startup fallback if PORT is occupied
PORT_RETRY_COUNT=3

# Rate limits (per IP / 15 min)
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=40

# Optional SMTP for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Seed script defaults (npm run seed)
SEED_ADMIN_EMAIL=admin@vericlaim.gov
SEED_ADMIN_PASSWORD=Admin123!
